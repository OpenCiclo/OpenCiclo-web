<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <!-- The still mark on the page background, exactly where the system splash
             drew it. It shows through the transparent WebView until the page paints,
             so the hand-over to the web boot splash has no blank frames. Once the
             page is up, its own background covers it. -->
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <!-- Launch screen: the brand mark on the page background. Android 12+ draws it
         from the windowSplashScreen* items (disc = icon background color, sea =
         icon), older versions from @drawable/splash. Then the web boot splash
         (apps/web/components/boot-splash.tsx) takes over with the same mark at the
         same size, moving. Colors and drawables come from `npm run icons`. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen.IconBackground">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brand_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_sea</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand_mark_disc</item>
    </style>
</resources>