{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local",
    "requireCommit": true
  },
  "build": {
    "ios-simulator": {
      "withoutCredentials": true,
      "env": {
        "CICLO_API_BASE": "https://www.openciclo.com"
      },
      "ios": {
        "simulator": true,
        "config": "ios-simulator.yml",
        "scheme": "App",
        "image": "latest"
      },
      "node": "24.11.0"
    }
  }
}
